<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: launchd/install.sh substitutes __REPO__ and __HOME__ and writes
     the result to ~/Library/LaunchAgents/com.zy.assistant.plist. launchd starts
     with a minimal PATH, so node is looked up in the same places run.sh does. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zy.assistant</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/launchd/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/zy-assistant.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/zy-assistant.log</string>
</dict>
</plist>
